{
  "name": "techzone/ecommerce",
  "description": "TechZone PHP eCommerce \u2014 root package for Railway/Railpack PHP detection",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "config": {
    "optimize-autoloader": true
  },
  "license": "MIT",
  "scripts": {
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
  }
}
