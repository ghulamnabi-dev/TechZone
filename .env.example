# TechZone configuration (12-factor). Copy to .env for local development;
# real environment variables always take precedence. Never commit .env.

# Database: mysql://user:password@host:port/database
# (alternatively DB_HOST / DB_USER / DB_PASS / DB_NAME)
DATABASE_URL=mysql://techzone:techzone@127.0.0.1:3306/techzone_db

# Public base URL, used for links sent by email (password reset)
APP_URL=http://localhost:8080

# 1 = show error details and PHP warnings in responses (local only, never in
# production). Default 0: errors are logged and users get a generic message.
APP_DEBUG=0

# Admin self sign-up is DISABLED (HTTP 403) unless this is set. When set, the
# "Invite code" field on AdminPortal/auth/signup.php must match it exactly
# (sent as "invite_code"); wrong codes are throttled like failed logins.
# Use a long random value, e.g. ADMIN_SIGNUP_CODE=demo-invite-2026 for a demo.
ADMIN_SIGNUP_CODE=

# CSRF: 1 = every POST/PUT/PATCH/DELETE must carry the session token (X-CSRF-Token
# header, csrf_token form field or JSON key), otherwise HTTP 403. All bundled pages
# send it (<meta name="csrf-token"> + the fetch wrapper in assets/js/common.js and
# csrf_field() in HTML forms), so 1 is the recommended setting.
# 0 = transition mode: token-less AJAX is accepted only from the same Origin/Referer
# (a wrong token is still rejected). The code default when unset is 0.
CSRF_STRICT=1

# Password reset delivery. PASSWORD_RESET_EMAIL=1 sends the link with mail()
# (built from APP_URL). PASSWORD_RESET_SHOW_LINK=1 prints the reset link on the
# forgot-password page instead (demos / no mail server only: anyone who knows an
# account's email + name/username + phone could then reset it). Defaults to APP_DEBUG.
PASSWORD_RESET_EMAIL=0
PASSWORD_RESET_SHOW_LINK=0

# 1 = trust X-Forwarded-For / X-Forwarded-Proto (behind Railway or a load balancer)
TRUST_PROXY=0

# 1 = enable MarketingSite/tools/verify-assets.php (discloses filesystem paths)
ENABLE_DEV_TOOLS=0
